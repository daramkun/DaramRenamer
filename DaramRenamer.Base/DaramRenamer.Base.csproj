<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>DaramRenamer</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="System.IO.Hashing" Version="10.0.0" />
      <PackageReference Include="z440.atl.core" Version="7.18.0" />
      <PackageReference Include="MetadataExtractor" Version="2.9.3" />
      <PackageReference Include="ZLinq" Version="1.5.4" />
      <PackageReference Include="ZLinq.DropInGenerator" Version="1.5.4">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="ZString" Version="2.6.0" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="DaramRenamer.Test" />
      <EmbeddedResource Include="Strings\Strings.csv" LogicalName="DaramRenamer.Strings.Strings.csv" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\DaramRenamer.Generators\DaramRenamer.Generators.csproj"
                        OutputItemType="Analyzer"
                        ReferenceOutputAssembly="false"
                        PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="UpdateInfo.cs" />
    </ItemGroup>
</Project>
