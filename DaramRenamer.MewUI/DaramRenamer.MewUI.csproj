<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <OutputType Condition="'$(OS)' == 'Windows_NT'">WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>DaramRenamer.MewUI</RootNamespace>
        <AssemblyName>DaramRenamer</AssemblyName>
        <ApplicationIcon Condition="'$(OS)' == 'Windows_NT'">Resources\ProgramIcon.ico</ApplicationIcon>
        <ApplicationManifest Condition="'$(OS)' == 'Windows_NT'">DaramRenamer.MewUI.manifest</ApplicationManifest>
        <Version Condition="'$(Version)' == ''">2026.10.1</Version>
        <Copyright>Copyright ⓒ 2013-2026 Jin Jae-yeon</Copyright>
    </PropertyGroup>

    <PropertyGroup>
        <PublishAot>true</PublishAot>
        <OptimizationPreference>Size</OptimizationPreference>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aprillz.MewUI" Version="0.22.1" />
        <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
        <ProjectReference Include="..\DaramRenamer.Base\DaramRenamer.Base.csproj" />
        <EmbeddedResource Include="Resources\ToolBarIcons\*.png">
            <LogicalName>DaramRenamer.MewUI.Resources.ToolBarIcons.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Resources\Icon.jpg">
            <LogicalName>DaramRenamer.MewUI.Resources.Icon.jpg</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Resources\ProgramIcon.ico">
            <LogicalName>DaramRenamer.MewUI.Resources.ProgramIcon.ico</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="..\LICENSE.md">
            <Link>Resources\LICENSE.md</Link>
            <LogicalName>DaramRenamer.MewUI.Resources.LICENSE.md</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

</Project>
