<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <OutputType Condition="'$(OS)' == 'Windows_NT'">WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>DaramRenamer.MewUI</RootNamespace>
        <AssemblyName>DaramRenamer</AssemblyName>
        <ApplicationIcon Condition="'$(OS)' == 'Windows_NT'">Resources\ProgramIcon.ico</ApplicationIcon>
        <ApplicationManifest Condition="'$(OS)' == 'Windows_NT'">DaramRenamer.MewUI.manifest</ApplicationManifest>
        <Version Condition="'$(Version)' == ''">2024.7.3</Version>
        <Copyright>Copyright ⓒ 2013-2024 Jin Jae-yeon</Copyright>
    </PropertyGroup>

    <PropertyGroup>
        <PublishAot>true</PublishAot>
    </PropertyGroup>

    <ItemGroup>
        <!-- TagLibSharp resolves media handlers through Type values and Activator.CreateInstance. -->
        <TrimmerRootAssembly Include="TagLibSharp" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Aprillz.MewUI" Version="0.22.1" />
        <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
        <ProjectReference Include="..\DaramRenamer.Base\DaramRenamer.Base.csproj" />
        <Content Include="Resources\ToolBarIcons\*.png">
            <Link>Resources\ToolBarIcons\%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Resources\Icon.jpg">
            <Link>Resources\Icon.jpg</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Resources\ProgramIcon.ico">
            <Link>Resources\ProgramIcon.ico</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <EmbeddedResource Include="..\LICENSE.md">
            <Link>Resources\LICENSE.md</Link>
            <LogicalName>DaramRenamer.MewUI.Resources.LICENSE.md</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

</Project>
